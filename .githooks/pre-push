#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
head=$(git rev-parse HEAD)
updates=0
active=0
while read -r local_ref local_sha remote_ref remote_sha extra || [[ -n ${local_ref:-} ]]; do
  [[ -n ${local_ref:-} ]] || { echo 'pre-push: malformed ref input.' >&2; exit 1; }
  if [[ -n ${extra:-} || ! ${local_sha:-} =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ || ! ${remote_sha:-} =~ ^([0-9a-f]{40}|[0-9a-f]{64})$ ]]; then
    echo 'pre-push: malformed ref input. No checks skipped.' >&2
    exit 1
  fi
  updates=$((updates + 1))
  [[ $local_sha =~ ^0+$ ]] && continue
  if [[ $local_sha != "$head" ]]; then
    echo 'pre-push: check out the pushed commit and push only HEAD. No stash or checkout is performed.' >&2
    exit 1
  fi
  active=$((active + 1))
done
if [[ $updates -gt 0 && $active -eq 0 ]]; then exit 0; fi
status=$(git status --porcelain --untracked-files=normal)
if [[ -n "$status" ]]; then
  echo 'pre-push: commit or remove local changes. Checks must validate exactly pushed HEAD.' >&2
  exit 1
fi
if ! command -v rustup >/dev/null 2>&1 ||
   ! rustup run 1.96.1 cargo --version >/dev/null 2>&1 ||
   ! rustup run 1.96.1 rustfmt --version >/dev/null 2>&1 ||
   ! rustup run 1.96.1 cargo-clippy --version >/dev/null 2>&1; then
  echo 'pre-push: prepare tools explicitly with rustup toolchain install 1.96.1 --profile minimal --component rustfmt --component clippy; then cargo +1.96.1 fetch --locked.' >&2
  exit 1
fi
rustup run 1.96.1 cargo fmt --all -- --check
rustup run 1.96.1 cargo check --workspace --locked --offline
rustup run 1.96.1 cargo clippy --workspace --all-features --locked --offline
